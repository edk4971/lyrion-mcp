# --- Lyrion (LMS) connection ---
LMS_HOST=your-lms-host.local
LMS_PORT=9000
LMS_USERNAME=
LMS_PASSWORD=
# Set to 1/true to use https for the LMS connection (default: off)
LMS_HTTPS=

# --- MCP transport ---
# stdio (default) | sse | streamable-http
# Use sse or streamable-http to expose the server over HTTP (e.g. in Docker).
MCP_TRANSPORT=stdio
# Only used for sse/streamable-http transports:
MCP_HOST=0.0.0.0
MCP_PORT=8000
